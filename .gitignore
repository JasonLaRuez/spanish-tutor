private/

# --- Data -------------------------------------------------------------------
# Raw corpora (Tatoeba, Subtlex-ESP, Gutenberg downloads) are large and
# re-downloadable; processed artifacts are regenerated by the pipeline.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Local databases and vector stores
*.db
*.sqlite
*.sqlite3
chroma/

